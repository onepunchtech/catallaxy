                            description = "The type of provider to use such as \"Secret\", or \"ConfigMap\".";
                          };
                        };
                        freeformType = types.attrs;
                      })
                    );
                    default = null;
                    description = "The provider for the CA bundle to use to validate Vault server certificate.";
                  };
                  forwardInconsistent = mkOption {
                    type = (types.nullOr types.bool);
                    default = null;
                    description = ''
                      ForwardInconsistent tells Vault to forward read-after-write requests to the Vault
                      leader instead of simply retrying within a loop. This can increase performance if
                      the option is enabled serverside.
                      https://www.vaultproject.io/docs/configuration/replication#allow_forwarding_via_header
                    '';
                  };
                  headers = mkOption {
                    type = (types.nullOr (types.attrsOf types.str));
                    default = null;
                    description = "Headers to be added in Vault request";
                  };
                  namespace = mkOption {
                    type = (types.nullOr types.str);
                    default = null;
                    description = ''
                      Name of the vault namespace. Namespaces is a set of features within Vault Enterprise that allows
                      Vault environments to support Secure Multi-tenancy. e.g: "ns1".
                      More about namespaces can be found here https://www.vaultproject.io/docs/enterprise/namespaces
                    '';
                  };
                  path = mkOption {
                    type = (types.nullOr types.str);
                    default = null;
                    description = ''
                      Path is the mount path of the Vault KV backend endpoint, e.g:
                      "secret". The v2 KV secret engine version specific "/data" path suffix
                      for fetching secrets from Vault is optional and will be appended
                      if not present in specified path.
                    '';
                  };
                  readYourWrites = mkOption {
                    type = (types.nullOr types.bool);
                    default = null;
                    description = ''
                      ReadYourWrites ensures isolated read-after-write semantics by
                      providing discovered cluster replication states in each request.
                      More information about eventual consistency in Vault can be found here
                      https://www.vaultproject.io/docs/enterprise/consistency
                    '';
                  };
                  server = mkOption {
                    type = types.str;
                    description = "Server is the connection address for the Vault server, e.g: \"https://vault.example.com:8200\".";
                  };
                  tls = mkOption {
                    type = (
                      types.nullOr (mkTypedSubmodule {
                        options = {
                          certSecretRef = mkOption {
                            type = (
                              types.nullOr (mkTypedSubmodule {
                                options = {
                                  key = mkOption {
                                    type = (types.nullOr types.str);
                                    default = null;
                                    description = ''
                                      A key in the referenced Secret.
                                      Some instances of this field may be defaulted, in others it may be required.
                                    '';
                                  };
                                  name = mkOption {
                                    type = (types.nullOr types.str);
                                    default = null;
                                    description = "The name of the Secret resource being referred to.";
                                  };
                                  namespace = mkOption {
                                    type = (types.nullOr types.str);
                                    default = null;
                                    description = ''
                                      The namespace of the Secret resource being referred to.
                                      Ignored if referent is not cluster-scoped, otherwise defaults to the namespace of the referent.
                                    '';
                                  };
                                };
                                freeformType = types.attrs;
                              })
                            );
                            default = null;
                            description = ''
                              CertSecretRef is a certificate added to the transport layer
                              when communicating with the Vault server.
                              If no key for the Secret is specified, external-secret will default to 'tls.crt'.
                            '';
                          };
                          keySecretRef = mkOption {
                            type = (
                              types.nullOr (mkTypedSubmodule {
                                options = {
                                  key = mkOption {
                                    type = (types.nullOr types.str);
                                    default = null;
                                    description = ''
                                      A key in the referenced Secret.
                                      Some instances of this field may be defaulted, in others it may be required.
                                    '';
                                  };
                                  name = mkOption {
                                    type = (types.nullOr types.str);
                                    default = null;
                                    description = "The name of the Secret resource being referred to.";
                                  };
                                  namespace = mkOption {
                                    type = (types.nullOr types.str);
                                    default = null;
                                    description = ''
                                      The namespace of the Secret resource being referred to.
                                      Ignored if referent is not cluster-scoped, otherwise defaults to the namespace of the referent.
                                    '';
                                  };
                                };
                                freeformType = types.attrs;
                              })
                            );
                            default = null;
                            description = ''
                              KeySecretRef to a key in a Secret resource containing client private key
                              added to the transport layer when communicating with the Vault server.
                              If no key for the Secret is specified, external-secret will default to 'tls.key'.
                            '';
                          };
                        };
                        freeformType = types.attrs;
                      })
                    );
                    default = null;
                    description = ''
                      The configuration used for client side related TLS communication, when the Vault server
                      requires mutual authentication. Only used if the Server URL is using HTTPS protocol.
                      This parameter is ignored for plain HTTP protocol connection.
                      It's worth noting this configuration is different from the "TLS certificates auth method",
                      which is available under the `auth.cert` section.
                    '';
                  };
                  version = mkOption {
                    type = (
                      types.nullOr (
                        types.enum [
                          "v1"
                          "v2"
                        ]
                      )
                    );
                    default = null;
                    description = ''
                      Version is the Vault KV secret engine version. This can be either "v1" or
                      "v2". Version defaults to "v2".
                    '';
                  };
                };
                freeformType = types.attrs;
              }
            );
            description = "Vault provider common spec";
          };
          resultType = mkOption {
            type = (
              types.nullOr (
                types.enum [
                  "Data"
                  "Auth"
                  "Raw"
                ]
              )
            );
            default = null;
            description = ''
              Result type defines which data is returned from the generator.
              By default it is the "data" section of the Vault API response.
              When using e.g. /auth/token/create the "data" section is empty but
              the "auth" section contains the generated token.
              Please refer to the vault docs regarding the result data structure.
              Additionally, accessing the raw response is possibly by using "Raw" result type.
            '';
          };
          retrySettings = mkOption {
            type = (
              types.nullOr (mkTypedSubmodule {
                options = {
                  maxRetries = mkOption {
                    type = (types.nullOr types.int);
                    default = null;
                  };
                  retryInterval = mkOption {
                    type = (types.nullOr types.str);
                    default = null;
                  };
                };
                freeformType = types.attrs;
              })
            );
            default = null;
            description = "Used to configure http retries if failed";
          };
        };
        freeformType = types.attrs;
      }
    );
  };

  Webhook = mkResource {
    apiVersion = "generators.external-secrets.io/v1alpha1";
    kind = "Webhook";
    specType = (
      mkTypedSubmodule {
        options = {
          body = mkOption {
            type = (types.nullOr types.str);
            default = null;
            description = "Body";
          };
          caBundle = mkOption {
            type = (types.nullOr types.str);
            default = null;
            description = ''
              PEM encoded CA bundle used to validate webhook server certificate. Only used
              if the Server URL is using HTTPS protocol. This parameter is ignored for
              plain HTTP protocol connection. If not set the system root certificates
              are used to validate the TLS connection.
            '';
          };
          caProvider = mkOption {
            type = (
              types.nullOr (mkTypedSubmodule {
                options = {
                  key = mkOption {
                    type = (types.nullOr types.str);
                    default = null;
                    description = "The key where the CA certificate can be found in the Secret or ConfigMap.";
                  };
                  name = mkOption {
                    type = types.str;
                    description = "The name of the object located at the provider type.";
                  };
                  namespace = mkOption {
                    type = (types.nullOr types.str);
                    default = null;
                    description = "The namespace the Provider type is in.";
                  };
                  type = mkOption {
                    type = (
                      types.enum [
                        "Secret"
                        "ConfigMap"
                      ]
                    );
                    description = "The type of provider to use such as \"Secret\", or \"ConfigMap\".";
                  };
                };
                freeformType = types.attrs;
              })
            );
            default = null;
            description = "The provider for the CA bundle to use to validate webhook server certificate.";
          };
          headers = mkOption {
            type = (types.nullOr (types.attrsOf types.str));
            default = null;
            description = "Headers";
          };
          method = mkOption {
            type = (types.nullOr types.str);
            default = null;
            description = "Webhook Method";
          };
          result = mkOption {
            type = (
              mkTypedSubmodule {
                options = {
                  jsonPath = mkOption {
                    type = (types.nullOr types.str);
                    default = null;
                    description = "Json path of return value";
                  };
                };
                freeformType = types.attrs;
              }
            );
            description = "Result formatting";
          };
          secrets = mkOption {
            type = (
              types.nullOr (
                types.listOf (mkTypedSubmodule {
                  options = {
                    name = mkOption {
                      type = types.str;
                      description = "Name of this secret in templates";
                    };
                    secretRef = mkOption {
                      type = (
                        mkTypedSubmodule {
                          options = {
                            key = mkOption {
                              type = (types.nullOr types.str);
                              default = null;
                              description = "The key where the token is found.";
                            };
                            name = mkOption {
                              type = (types.nullOr types.str);
                              default = null;
                              description = "The name of the Secret resource being referred to.";
                            };
                          };
                          freeformType = types.attrs;
                        }
                      );
                      description = "Secret ref to fill in credentials";
                    };
                  };
                  freeformType = types.attrs;
                })
              )
            );
            default = null;
            description = ''
              Secrets to fill in templates
              These secrets will be passed to the templating function as key value pairs under the given name
            '';
          };
          timeout = mkOption {
            type = (types.nullOr types.str);
            default = null;
            description = "Timeout";
          };
          url = mkOption {
            type = types.str;
            description = "Webhook url to call";
          };
        };
        freeformType = types.attrs;
      }
    );
  };

}
